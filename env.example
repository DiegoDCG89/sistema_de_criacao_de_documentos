# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).

# Credenciais OAuth2 do Google Cloud (Tela de consentimento + Client OAuth "Desktop" ou "Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtido uma única vez via https://developers.google.com/oauthplayground
# (autorizar o escopo do Google Drive e trocar o código pelo refresh_token)
GOOGLE_REFRESH_TOKEN=

# ID da pasta raiz no Google Drive onde as subpastas de cada solicitação serão criadas
PARENT_FOLDER_ID=

# Porta do servidor (opcional, padrão 3000)
PORT=3000
