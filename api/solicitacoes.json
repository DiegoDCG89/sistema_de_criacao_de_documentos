import { sql } from '@vercel/postgres';

function validarToken(req) {
  const authHeader = req.headers.authorization;
  if (!authHeader) return false;
  const token = authHeader.replace('Bearer ', '').trim();
  const ADMIN_USER = process.env.ADMIN_USER || 'root';
  const ADMIN_SECRET_KEY = process.env.ADMIN_SECRET_KEY || 'aeromovel';
  const expectedToken = Buffer.from(`${ADMIN_USER}:${ADMIN_SECRET_KEY}`).toString('base64');
  return token === expectedToken;
}

export default async function handler(req, res) {
  // GET: Obter todas as solicitações (Somente Admin autenticado)
  if (req.method === 'GET') {
    if (!validarToken(req)) {
      return res.status(401).json({ error: 'Acesso não autorizado' });
    }

    try {
      const { rows } = await sql`
        SELECT * FROM solicitacoes 
        ORDER BY criado_em DESC;
      `;
      return res.status(200).json(rows);
    } catch (error) {
      console.error('Erro ao buscar solicitações:', error);
      return res.status(500).json({ error: error.message });
    }
  }

  // POST: Submeter nova solicitação (Qualquer militar)
  if (req.method === 'POST') {
    try {
      const sol = req.body;
      if (!sol || !sol.id || !sol.nomeCompleto) {
        return res.status(400).json({ error: 'Dados incompletos da solicitação' });
      }

      await sql`
        INSERT INTO solicitacoes (
          id, data_criacao, status, posto, nome_completo, arma, idt_militar,
          cpf, prec_cp, telefone, email, om_atual, banco, agencia, conta_corrente,
          om_origem, om_destino, cidade_residencia, documento_autorizador,
          motivo_movimentacao, data_desligamento, data_inicio_curso, data_termino_curso,
          data_ajuste_contas, tipo_movimentacao, modalidade,
          url_pdf_docs, url_diex, url_nota_bar, url_op, dados_completos
        ) VALUES (
          ${sol.id},
          ${sol.dataCriacao || ''},
          ${sol.status || 'Pendente'},
          ${sol.posto || ''},
          ${sol.nomeCompleto || ''},
          ${sol.arma || ''},
          ${sol.idtMilitar || ''},
          ${sol.cpf || ''},
          ${sol.precCp || ''},
          ${sol.telefone || ''},
          ${sol.email || ''},
          ${sol.omAtual || ''},
          ${sol.banco || ''},
          ${sol.agencia || ''},
          ${sol.contaCorrente || ''},
          ${sol.omOrigem || ''},
          ${sol.omDestino || ''},
          ${sol.cidadeResidenciaFutura || ''},
          ${sol.documentoAutorizador || ''},
          ${sol.motivoMovimentacao || ''},
          ${sol.dataDesligamento || ''},
          ${sol.dataInicioCurso || ''},
          ${sol.dataTerminoCurso || ''},
          ${sol.dataAjusteContas || ''},
          ${sol.tipoMovimentacao || ''},
          ${sol.modalidade || ''},
          ${sol.urlPdfDocs || ''},
          ${sol.urlDiex || ''},
          ${sol.urlNotaBar || ''},
          ${sol.urlOp || ''},
          ${JSON.stringify(sol)}
        );
      `;

      return res.status(201).json({ success: true, id: sol.id });
    } catch (error) {
      console.error('Erro ao salvar solicitação:', error);
      return res.status(500).json({ error: error.message });
    }
  }

  // DELETE: Excluir solicitação (Somente Admin autenticado)
  if (req.method === 'DELETE') {
    if (!validarToken(req)) {
      return res.status(401).json({ error: 'Acesso não autorizado' });
    }

    const { id } = req.query;
    if (!id) {
      return res.status(400).json({ error: 'ID não informado' });
    }

    try {
      await sql`DELETE FROM solicitacoes WHERE id = ${id};`;
      return res.status(200).json({ success: true, message: `Solicitação ${id} removida` });
    } catch (error) {
      console.error('Erro ao deletar solicitação:', error);
      return res.status(500).json({ error: error.message });
    }
  }

  return res.status(405).json({ error: 'Método não permitido' });
}